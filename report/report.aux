\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Left: parameters vs.\ pre-training tokens. A saw only 7{} tokens per parameter, cycling 10 times over 37\,M unique tokens. B was trained past the Chinchilla ratio, and C sits just below it. Centre: pre-training compute vs.\ uniform mean bpb, with a power-law fit through the three points. Right: measured training energy by stage.}}{4}{figure.caption.10}\protected@file@percent }
\newlabel{fig:scaling}{{4}{4}{Left: parameters vs.\ pre-training tokens. A saw only \tppA {} tokens per parameter, cycling 10 times over \uniqueA \,M unique tokens. B was trained past the Chinchilla ratio, and C sits just below it. Centre: pre-training compute vs.\ uniform mean bpb, with a power-law fit through the three points. Right: measured training energy by stage}{figure.caption.10}{}}
